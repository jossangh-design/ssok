<Window x:Class="Ssok.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="쏙 안내" Width="640" Height="620" MinWidth="480" MinHeight="420"
        Icon="/Assets/ssok.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="14"
        Background="{StaticResource Canvas}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="TabRadio" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="Doc" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Body}"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18,16,18,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="쏙 안내" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource Muted}"
                       Margin="10,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="로그 폴더 열기" Style="{StaticResource OutlineButton}" Margin="0"
                    Padding="12,6" FontSize="13" Click="OnOpenLogs"/>
            <Button DockPanel.Dock="Right" Content="닫기" Style="{StaticResource PrimaryButton}" Width="96" Height="34"
                    FontSize="14" IsCancel="True" IsDefault="True" Click="OnClose"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource Track}" CornerRadius="10" Padding="3" Margin="0,0,0,12">
            <UniformGrid Columns="3">
                <RadioButton x:Name="PrivacyTab" GroupName="Tab" Content="개인정보 안내" Style="{StaticResource TabRadio}"
                             IsChecked="True" Checked="OnTab"/>
                <RadioButton x:Name="TermsTab" GroupName="Tab" Content="이용약관" Style="{StaticResource TabRadio}" Checked="OnTab"/>
                <RadioButton x:Name="NoticesTab" GroupName="Tab" Content="제3자 고지" Style="{StaticResource TabRadio}" Checked="OnTab"/>
            </UniformGrid>
        </Border>

        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel x:Name="Body"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
